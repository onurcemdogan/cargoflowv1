  "completedCriteria": [
    "Verified SOAP envelopes for GetOrderWithIntegrationCode (userName/password/integrationCode) and GetBarcode (Username/Password/integrationCode) wired in arasClient with test locks AR-24b/c, ARC-5/6b; evidence .ai/research/ARAS-EXPANSION/20260927T123508.646306Z-d4e2b02830054596b75c122f9c311ea5.json",
