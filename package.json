{
  "name": "cargoflow-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:web:host": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "node server/index.mjs",
    "dev:host": "concurrently -k \"npm:dev:api\" \"npm:dev:web:host\"",
    "start": "node server/index.mjs",
    "setup:server": "node scripts/setup-server.mjs",
    "health": "node scripts/health-check.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:surat": "node server/testing/runSuratSuite.mjs",
    "test:dashboard": "node --test server/dashboard-analytics-flow.test.mjs server/dashboard-health-flow.test.mjs",
    "test:surat:serendip": "node server/surat-serendip-live-check.mjs",
    "diagnose:surat-network": "node server/diagnose-surat-network.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node server/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:import:legacy-shipments": "node server/shipments/importLegacyShipmentsCli.ts",
    "db:import:legacy-orders": "node server/orders/importLegacyOrdersCli.ts",
    "db:import:legacy-products": "node server/products/importLegacyProductsCli.ts",
    "marketplace-account:backfill": "node server/integrations/backfillMarketplaceAccountCli.ts",
    "orders:reconcile:diagnose": "node server/analytics/reconcileOrdersCli.ts",
    "orders:reconcile": "node server/orders/reconcileOrdersCli.ts",
    "dashboard:reconcile": "node server/analytics/dashboardReconcileCli.ts",
    "orders:count-reconcile": "node server/analytics/orderCountReconcileCli.ts",
    "order-lines:repair": "node server/orders/orderLineRepairCli.ts",
    "orders:retention:check": "node server/orders/retentionCheckCli.ts",
    "orders:malformed:check": "node server/orders/malformedOrderAuditCli.ts",
    "trendyol:package-status:check": "node server/orders/trendyolPackageIdentityTraceCli.ts",
    "surat:zpl:diagnose": "node server/integrations/suratZplDiagnosticCli.ts",
    "surat:zpl:mask": "node server/labels/maskSuratZplCli.ts",
    "platform-admin:create": "node server/admin/createPlatformAdminCli.ts",
    "platform-admin:reset-password": "node server/admin/resetPlatformAdminPasswordCli.ts",
    "org-user:reset-password": "node server/admin/resetOrgUserPasswordCli.ts",
    "surat:billing:scan": "node --env-file-if-exists=.env server/shipments/suratBillingScanCli.ts",
    "trendyol:sync:bench": "node server/marketplaces/trendyolSyncBenchmarkCli.ts",
    "surat:billing:inspect": "node --env-file-if-exists=.env server/shipments/suratBillingInspectCli.ts",
    "db:verify": "node server/admin/verifyDatabaseCli.ts",
    "admin:create-platform-admin": "node server/admin/createPlatformAdminCli.ts",
    "admin:reset-platform-admin-password": "node server/admin/resetPlatformAdminPasswordCli.ts",
    "admin:reset-org-user-password": "node server/admin/resetOrgUserPasswordCli.ts",
    "benchmark:label-bundles": "node server/benchmarks/labelBundleBenchmark.ts",
    "surat:ssp-acceptance:check": "node server/shipments/sspAcceptanceCheckCli.ts",
    "surat:trace:inspect": "node --env-file-if-exists=.env server/shipments/suratTraceInspectCli.ts",
    "surat:create:eligibility:inspect": "node --env-file-if-exists=.env server/shipments/suratCreateEligibilityInspectCli.ts",
    "surat:canary:precheck": "node --env-file-if-exists=.env server/shipments/suratCanaryPrecheckCli.ts",
    "surat:print-zpl:repair": "node server/shipments/repairPrintZplCli.ts",
    "auto-label:catchup:inspect": "tsx server/shipments/autoLabelCatchupCli.ts",
    "auto-label:catchup:enqueue": "tsx server/shipments/autoLabelCatchupCli.ts --enqueue",
    "auto-label:legacy-retry:inspect": "tsx server/shipments/legacyRetryQuarantineCli.ts",
    "auto-label:legacy-retry:quarantine": "tsx server/shipments/legacyRetryQuarantineCli.ts --quarantine",
    "auto-label:job:inspect": "tsx server/shipments/legacyRetryQuarantineCli.ts --job",
    "auto-label:job:reactivate": "tsx server/shipments/legacyRetryQuarantineCli.ts --reactivate",
    "auto-label:job:preflight": "tsx server/shipments/legacyRetryQuarantineCli.ts --preflight",
    "auto-label:job:run-once": "tsx server/shipments/singleLabelJobRunnerCli.ts",
    "auto-label:canary:candidates": "tsx server/shipments/canaryCandidateCli.ts",
    "auto-label:blocked:inspect": "tsx server/shipments/blockedJobRecoveryCli.ts",
    "auto-label:blocked:reactivate": "tsx server/shipments/blockedJobRecoveryCli.ts --reactivate",
    "auto-label:worker:preflight": "node server/shipments/workerBootstrapPreflightCli.ts",
    "auto-label:stale:inspect": "node server/shipments/staleJobRecoveryCli.ts",
    "auto-label:stale:recover": "node server/shipments/staleJobRecoveryCli.ts --recover",
    "auto-label:canary:observe": "node server/shipments/canaryObserverCli.ts"
  },
  "dependencies": {
    "@types/jsbarcode": "^3.11.4",
    "argon2": "^0.45.0",
    "concurrently": "^10.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.20.0",
    "pg": "^8.22.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zpl-renderer-js": "4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "4.1.10"
  }
}
